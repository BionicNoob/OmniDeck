<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- CYBER -->
    <style name="Theme.Omni.Cyber" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cyber_bg</item>
        <item name="android:colorBackground">@color/cyber_bg</item>
        <item name="android:colorPrimary">@color/cyber_surface</item>
        <item name="android:colorPrimaryDark">@color/cyber_surface</item>
        <item name="android:colorAccent">@color/cyber_accent</item>
        <item name="android:colorControlActivated">@color/cyber_accent</item>
        <item name="android:statusBarColor">@color/cyber_surface</item>
        <item name="android:navigationBarColor">@color/cyber_surface</item>
        <item name="android:textColorPrimary">@color/cyber_text</item>
        <item name="android:textColorSecondary">@color/cyber_dim</item>
        <item name="android:alertDialogTheme">@style/Theme.Omni.Cyber.Dialog</item>
    </style>

    <style name="Theme.Omni.Cyber.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/cyber_accent</item>
        <item name="android:colorBackground">@color/cyber_panel</item>
        <item name="android:textColorPrimary">@color/cyber_text</item>
        <item name="android:textColorSecondary">@color/cyber_dim</item>
    </style>

    <!-- LIGHT -->
    <style name="Theme.Omni.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:colorBackground">@color/light_bg</item>
        <item name="android:colorPrimary">@color/light_surface</item>
        <item name="android:colorPrimaryDark">@color/light_surface</item>
        <item name="android:colorAccent">@color/light_accent</item>
        <item name="android:colorControlActivated">@color/light_accent</item>
        <item name="android:statusBarColor">@color/light_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_dim</item>
        <item name="android:alertDialogTheme">@style/Theme.Omni.Light.Dialog</item>
    </style>

    <style name="Theme.Omni.Light.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/light_accent</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_dim</item>
    </style>

    <!-- DARK -->
    <style name="Theme.Omni.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="android:colorPrimary">@color/dark_surface</item>
        <item name="android:colorPrimaryDark">@color/dark_surface</item>
        <item name="android:colorAccent">@color/dark_accent</item>
        <item name="android:colorControlActivated">@color/dark_accent</item>
        <item name="android:statusBarColor">@color/dark_surface</item>
        <item name="android:navigationBarColor">@color/dark_surface</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_dim</item>
        <item name="android:alertDialogTheme">@style/Theme.Omni.Dark.Dialog</item>
    </style>

    <style name="Theme.Omni.Dark.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/dark_accent</item>
        <item name="android:colorBackground">@color/dark_panel</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_dim</item>
    </style>

    <!-- Starting window follows "System" (the default): Dark, or Light when the phone is light. -->
    <style name="Theme.Omni.Launch" parent="@style/Theme.Omni.Dark" />
</resources>
